STAGING_WORKER_NAME=replace-with-staging-worker-name
STAGING_D1_DATABASE_NAME=replace-with-staging-database-name
STAGING_D1_DATABASE_ID=replace-with-staging-database-id
STAGING_R2_BUCKET=replace-with-staging-bucket-name
STAGING_TAXONOMY_QUEUE=replace-with-staging-worker-name-taxonomy
STAGING_TAXONOMY_DLQ=replace-with-staging-worker-name-taxonomy-dlq
STAGING_URL=https://replace-with-staging-worker-url
STAGING_TURNSTILE_HOSTNAMES=replace-with-staging-worker-host,localhost,127.0.0.1
STAGING_TURNSTILE_SITEKEY=replace-with-staging-sitekey
STAGING_SECRETS_FILE=/absolute/path/to/secured/staging-secrets.env
